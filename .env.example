# Modo de datos: 'api' o 'local'
VITE_DATA_MODE=api

# Base URL del backend (usa el que ves en Swagger)
VITE_API_BASE_URL=https://localhost:7299

# (Opcional) Auto-login en DEV: el frontend hará POST /v1/auth/login al cargar
# Crea el usuario primero (Swagger: POST /v1/auth/register)
VITE_DEV_EMAIL=demo@example.com
VITE_DEV_PASSWORD=MyS3cret!
